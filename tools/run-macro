#!/usr/bin/env bash
set -euo pipefail

readonly SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly ROOT_DIR=$(cd "${SCRIPT_DIR}/.." && pwd)
readonly ROOTLOGON_PATH="${ROOT_DIR}/.rootlogon.C"
readonly -a MACRO_DIRS=("io/macro" "ana/macro" "plot/macro")
export AMARANTIN_ROOT_DIR="${ROOT_DIR}"
export AMARANTIN_BUILD_DIR="${AMARANTIN_BUILD_DIR:-build}"

usage() {
  cat <<'EOF'
usage: tools/run-macro <macro-name> [args...]

Runs a ROOT macro by friendly name without exposing the raw ROOT command line.

Literal values are inferred directly from the command line.
Optional prefixes can override inference:
  s:<text>   explicit string
  i:<int>    integer
  f:<float>  floating-point
  b:true     boolean
  n:null     nullptr

Without a prefix:
  true/false are passed as booleans
  integer literals are passed as integers
  floating-point literals are passed as floating-point values
  everything else is passed as a quoted string

Use s:<text> when a string value would otherwise look numeric.

Examples:
  tools/run-macro print_eventlist build/eventlists/run1.root
  tools/run-macro inspect_weights build/eventlists/run1.root beam-s0
  tools/run-macro inspect_cutflow build/eventlists/run1.root beam-s0
  tools/run-macro inspect_categories build/eventlists/run1.root beam-s0
  tools/run-macro plot_topological_score build/eventlists/run1.root beam-s0
  tools/run-macro plot_event_display build/eventlists/run1.root beam-s0 0 U detector
  tools/run-macro plot_event_display build/eventlists/run1.root beam-s0 0 U detector 512 512
  tools/run-macro mk_snapshot build/eventlists/run1.root train.root reco_neutrino_vertex_x,__w__
  tools/run-macro inspect_systematics output.dists.root beam-s0
  tools/run-macro inspect_covariance output.frac_cov.root

Available names are discovered from:
  io/macro
  ana/macro
  plot/macro
EOF
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

macro_name=${1//-/_}
shift

macro_path=
for macro_dir in "${MACRO_DIRS[@]}"; do
  candidate="${ROOT_DIR}/${macro_dir}/${macro_name}.C"
  if [[ -f "${candidate}" ]]; then
    macro_path=${candidate}
    break
  fi
done

if [[ -z "${macro_path}" ]]; then
  {
    echo "tools/run-macro: unknown macro: ${macro_name}"
    echo
    usage
  } >&2
  exit 1
fi

escape_cpp_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  printf '%s' "${s}"
}

literal_matches_kind() {
  local kind=$1
  local value=$2

  case "${kind}" in
    bool)
      [[ "${value}" == true || "${value}" == false ]]
      ;;
    int)
      [[ "${value}" =~ ^[-+]?[0-9]+$ ]]
      ;;
    float)
      [[ "${value}" =~ ^[-+]?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))([eE][-+]?[0-9]+)?$ ]]
      ;;
    *)
      return 1
      ;;
  esac
}

prefixed_literal() {
  local arg=$1
  local kind=
  local value=

  case "${arg}" in
    n:null)
      printf 'nullptr'
      return 0
      ;;
    n:*)
      printf 'tools/run-macro: invalid null literal: %s\n' "${arg}" >&2
      return 2
      ;;
    s:*)
      printf '"%s"' "$(escape_cpp_string "${arg#s:}")"
      return 0
      ;;
    b:*)
      kind=bool
      value=${arg#b:}
      ;;
    i:*)
      kind=int
      value=${arg#i:}
      ;;
    f:*)
      kind=float
      value=${arg#f:}
      ;;
    *)
      return 1
      ;;
  esac

  if ! literal_matches_kind "${kind}" "${value}"; then
    printf 'tools/run-macro: invalid %s literal: %s\n' "${kind}" "${arg}" >&2
    return 2
  fi
  printf '%s' "${value}"
}

to_cpp_literal() {
  local arg=$1
  local literal
  local prefixed_status

  if literal=$(prefixed_literal "${arg}"); then
    printf '%s' "${literal}"
    return 0
  else
    prefixed_status=$?
  fi

  if [[ ${prefixed_status} -eq 2 ]]; then
    return 2
  fi

  if literal_matches_kind bool "${arg}" ||
     literal_matches_kind int "${arg}" ||
     literal_matches_kind float "${arg}"; then
    printf '%s' "${arg}"
    return 0
  fi

  printf '"%s"' "$(escape_cpp_string "${arg}")"
}

build_invocation() {
  local path=$1
  shift

  if [[ $# -eq 0 ]]; then
    invocation=${path}
    return 0
  fi

  local -a raw_args=("$@")
  local -a args=()
  local raw_arg
  local literal
  local status
  for raw_arg in "${raw_args[@]}"; do
    if literal=$(to_cpp_literal "${raw_arg}"); then
      args+=("${literal}")
    else
      status=$?
      return "${status}"
    fi
  done

  local joined=
  printf -v joined '%s, ' "${args[@]}"
  joined=${joined%, }

  printf -v invocation '%s(%s)' "${path}" "${joined}"
}

invocation=
build_invocation "${macro_path}" "$@"
exec root -l -q "${ROOTLOGON_PATH}" "${invocation}"
